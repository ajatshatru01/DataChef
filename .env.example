# =============================================================================
# DataChef — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Provider Selection -------------------------------------------------------
# Options: "ollama" (local 100% open-source) or "huggingface" (cloud hosted)
DATACHEF_PROVIDER=ollama

# --- Ollama (Local Open-Source Inference) -------------------------------------
# Base URL of your local Ollama server (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Model name pulled in Ollama (e.g. gemma4, gemma2:9b, qwen2.5:14b, llama3.1:8b)
OLLAMA_MODEL=gemma4

# --- Hugging Face Inference (Cloud Alternative) --------------------------------
# Your Hugging Face API key (https://huggingface.co/settings/tokens)
HF_API_KEY=hf_...

# The model to use for inference when DATACHEF_PROVIDER=huggingface.
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
HF_INFERENCE_PROVIDER=auto

# --- Agent Loop Limits --------------------------------------------------------
# Maximum number of tool calls per investigation (cost control)
DATACHEF_MAX_TOOL_CALLS=10

# Maximum model round-trips (turns) per investigation
DATACHEF_MAX_TURNS=8

# Maximum wall-clock seconds per investigation before forced conclusion
DATACHEF_MAX_WALL_SECONDS=120

# Maximum tokens in a single tool result before truncation
DATACHEF_MAX_RESULT_TOKENS=2000

# Maximum discovery candidates to investigate in autonomous mode
DATACHEF_MAX_DISCOVERY_CANDIDATES=6

# --- Inference Parameters -----------------------------------------------------
# Temperature for model responses (lower = more deterministic tool selection)
DATACHEF_TEMPERATURE=0.2

# Maximum tokens in model response
DATACHEF_MAX_RESPONSE_TOKENS=1024

# API request timeout in seconds
DATACHEF_REQUEST_TIMEOUT=30

# Maximum retries on transient API failures (rate limits, 5xx errors)
DATACHEF_MAX_RETRIES=3

# --- Context Window -----------------------------------------------------------
# Number of recent tool results to include in each per-turn context
DATACHEF_CONTEXT_HISTORY_N=3

# --- Storage ------------------------------------------------------------------
# Directory for investigation records (NDJSON files, one per session)
# Defaults to ~/.datachef/investigations
# DATACHEF_INVESTIGATION_DIR=/path/to/custom/dir

# Directory for dataset profile cache
# Defaults to ~/.datachef/cache
# DATACHEF_CACHE_DIR=/path/to/custom/cache
